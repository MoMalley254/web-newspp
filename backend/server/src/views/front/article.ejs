<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error Page</title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-secondary">

  <div class="container mt-5">

    <% if (error && error.trim() !== '') { %>
      <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <div>
          <strong>Error:</strong> <br> <%= error %>
        </div>
        <br>
        <div>
          <button class="btn btn-outline-success btn-sm me-2" onclick="location.reload()">Reload</button>
          <button class="btn btn-outline-danger btn-sm" onclick="history.back()">Go Back</button>
        </div>
      </div>
    <% } else { %>

    <!-- You can add other content here -->
    <div class="text-center mt-5">
      <h2>Welcome to the Error Page</h2>
      <p>If no error is present, this message will be shown normally.</p>
    </div>
    <% } %>

  </div>

  <!-- Optional Bootstrap JS (if you need interactivity) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
