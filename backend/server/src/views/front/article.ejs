<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% if (status) { %>
      <meta property="og:title" content="<%= mag.title %> Issue <%= mag.issueNumber %>" />
      <meta property="og:description" content="<%= mag.description %>" />
      <meta property="og:url" content="<%= fullUrl %>" />
      <meta property="og:image" content="<%= `${url}/front${mag.coverImage.replaceAll('\\', '/')}` %>" />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Business Unusual Magazine" />
    <% } else { %>
      <meta property="og:title" content="Business Unusual Magazine" />
      <meta 
        property="og:description" 
        content="BUSINESS UNUSUAL MAGAZINE
          Aims to provide high-quality, accurate,
          and timely business content that
          empowers entrepreneurs, investors,
          and policymakers with the knowledge
          to make informed decisions, fostering
          innovation, economic growth, and sustainable development in Kenya
          and beyond." 
      />
      <meta property="og:url" content="<%= fullUrl %>" />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Business Unusual Magazine" />
    <% } %>
    <!-- Google Material Icons -->
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <!-- Bootstrap -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="view/public/assets/styles/stPageFlip.css" />
    <link rel="stylesheet" href="view/public/assets/styles/styles.css" />
    <title>Business Unusual</title>
  </head>
  <body>
    <% if (!status) { %>
    <div class="center container mt-3">
      <div
        class="alert alert-danger d-flex justify-content-between align-items-center"
        role="alert"
      >
        <div>
          <strong>Error:</strong> <br />
          <%= error %>
        </div>
        <br />
        <div>
          <button
            class="btn btn-outline-success btn-sm me-2"
            onclick="location.reload()"
          >
            Reload
          </button>
          <button
            class="btn btn-outline-danger btn-sm"
            onclick="history.back()"
          >
            Go Back
          </button>
        </div>
      </div>
    </div>
    <% } else { %>

    <!-- You can add other content here -->
    <div class="content-body">
      <section id="articlesSection" class="content">
        <h2 class="loader">
          Loading <span class="article-name"></span> content
          <span class="dots"></span>
        </h2>
        <div id="zoomWrapper">
          <div id="flipContainer" data-resource-url="<%= mag.htmlPath %>"></div>
        </div>

        <!-- <div
        class="offcanvas offcanvas-start text-bg-dark"
        tabindex="-1"
        id="thumbnailsCanvas"
        aria-labelledby="thumbnailsCanvasLabel"
      >
        <div class="offcanvas-header center">
          <h5 class="offcanvas-title" id="thumbnailsCanvasLabel">
            <%= mag.title %>
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
          ></button>
        </div>
        <div class="offcanvas-body bg-dark">
          <p><strong>Thumbnails</strong></p>
          <div id="thumbNailsContainer"></div>

          

          <br />
        </div>
      </div> -->

      </section>
      <section class="top">
        <!-- <div class="titles">
          <h1>E-Newspp</h1>
          <h2 id="magazineTitle"><%= mag.title %></h2>
        </div> -->
        <!-- controls top -->
        <div class="controls-top">
          <button id="btn-hide-controls" aria-label="Hide Controls">
            <i class="material-icons">keyboard_double_arrow_up</i>
          </button>

          <div class="top-show-controls">
            <div class="controls-row">
              <button
              id="btn-back"
              aria-label="Back to articles"
              onclick="history.back()"
            >
              <i class="material-icons">keyboard_backspace</i>
            </button>

            <button
              type="button"
              class="magInfoCanvasBtn"
              data-bs-toggle="offcanvas"
              data-bs-target="#magInfoCanvas"
              aria-controls="magInfoCanvas"
              aria-label="Magazine Info"
            >
              <i class="material-icons">menu_book</i>
            </button>

            <button
              type="button"
              class="showTocsBtn"
              data-bs-toggle="offcanvas"
              data-bs-target="#tableOfContentsCanvas"
              aria-controls="tableOfContentsCanvas"
              aria-label="Table of Contents"
              data-has-tocs="<%= mag.hasToc %>"
            >
              <i class="material-icons">toc</i>
            </button>

            <button id="btn-fullscreen" aria-label="Full Screen">
              <i class="material-icons">fullscreen</i>
            </button>

            <button
              id="btn-stretch"
              aria-label="Fill Screen"
            >
              <i class="material-icons" style="transform: rotate(90deg);">expand</i>
            </button>
            
             <button id="btn-zoom-in" aria-label="Zoom In">
              <i class="material-icons">zoom_in</i>
            </button> 

             <button id="btn-zoom-out" aria-label="Zoom Out">
              <i class="material-icons">zoom_out</i>
            </button>

            <button 
              id="btn-share" 
              aria-label="Share"
              data-bs-toggle="offcanvas"
              data-bs-target="#magShareCnvas"
              aria-controls="magShareCnvas"
              >
              <i class="material-icons">share</i>
            </button>
            </div> 

            

            <input
  id="zoomSlider"
  type="range"
  min="1"
  max="3"
  step="0.01"
  value="1"
/>
          </div>
          
        </div>

        <div
        class="offcanvas offcanvas-end text-bg-dark"
        tabindex="-1"
        id="magInfoCanvas"
        aria-labelledby="magInfoCanvasLabel"
      >
        <div class="offcanvas-header center">
          <h5 class="offcanvas-title" id="magInfoCanvasLabel">
            <%= mag.title %>
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
          ></button>
        </div>
        <div class="offcanvas-body bg-dark">
          <p><strong>Issue: <%= mag.issueNumber %></strong></p>
          <% const date = new Date(mag.publishDate); %>
          <p>
            <strong
              >Published: <%= ('0' + date.getDate()).slice(-2) %>-<%= ('0' +
              (date.getMonth() + 1)).slice(-2) %>-<%= date.getFullYear()
              %></strong
            >
          </p>

          <% if (mag.credits && Object.keys(mag.credits).length > 0) { %>
          <div class="mag-credits">
            <strong>Credits:</strong>
            <% Object.entries(mag.credits).forEach(([role, people]) => { let
            peopleArray = []; if (Array.isArray(people) && people.length > 0) {
            peopleArray = people; } else if (typeof people === 'string') {
            peopleArray = people.split(',').map(p => p.trim()); } %>
            <div>
              <strong
                ><%= role.charAt(0).toUpperCase() + role.slice(1) %>:</strong
              >
              <%= peopleArray.join(', ') %>
            </div>
            <% }) %>
          </div>
          <% } %>

          <br />
          <p>
            <strong
              >Description: <br />
              <%= mag.description %></strong
            >
          </p>

          <% if (mag.tags && mag.tags.length > 0) { %>
          <div class="mag-tags mb-3">
            <strong>Tags: <br /></strong>
            <% mag.tags.forEach(tag => { %>
            <a
              href="/front/tag/?tag=<%= tag.id %>"
              class="btn btn-primary btn-sm me-2 mb-2"
              target="_blank"
              ><%= tag.name %></a
            >
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>

      <div
  class="offcanvas offcanvas-bottom text-bg-dark"
  tabindex="-1"
  id="magShareCnvas"
  aria-labelledby="magShareCnvasLabel"
  style="height: 75vh;"
>
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="magShareCnvasLabel">Share <%= mag.title %></h5>
    <button
      type="button"
      class="btn-close btn-close-white"
      data-bs-dismiss="offcanvas"
      aria-label="Close"
    ></button>
  </div>
<div class="offcanvas-body">
  <h5 class="mb-3">Share this magazine</h5>

  <div class="d-flex flex-column flex-md-row">
    <a 
    id="whatsapp-share"
    href="#"
    class="btn btn-success mb-2 me-2 d-flex align-items-center" 
    target="_blank"
  >
    <span class="material-icons me-2"></span> Share on WhatsApp
  </a>

  <a 
    id="facebook-share"
    href="#"
    class="btn btn-primary mb-2 me-2 d-flex align-items-center"
    style="background-color: #3b5998;"
    target="_blank"
  >
    <span class="material-icons me-2">facebook</span> Share on Facebook
  </a>

  <a 
    id="twitter-share"
    href="#"
    class="btn btn-dark mb-2 me-2 d-flex align-items-center"
    target="_blank"
  >
    <span class="material-icons me-2">alternate_email</span> Share on X
  </a>

  <a 
    id="telegram-share"
    href="#"
    class="btn btn-info text-white mb-2 me-2 d-flex align-items-center"
    target="_blank"
  >
    <span class="material-icons me-2">send</span> Share on Telegram
  </a>

  <a 
    id="email-share"
    href="#"
    class="btn btn-secondary mb-2 me-2 d-flex align-items-center"
    target="_blank"
  >
    <span class="material-icons me-2">email</span> Share via Email
  </a>

  <a 
    id="sms-share"
    href="#"
    class="btn btn-primary mb-2 me-2 d-flex align-items-center"
  >
    <span class="material-icons me-2">sms</span> Share via SMS
  </a>

  <button 
    class="btn btn-secondary mb-2 me-2 d-flex align-items-center" 
    onclick="copyLink()"
  >
    <span class="material-icons me-2">content_copy</span> Copy Link
  </button>

  <button 
    class="btn btn-info text-white mb-2 me-2 d-flex align-items-center" 
    onclick="shareNative()"
  >
    <span class="material-icons me-2">share</span> Share via Device
  </button>
  </div>
</div>


  <div class="offcanvas-footer p-3 text-end">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">
      Close
    </button>
  </div>
</div>

<div
  class="offcanvas offcanvas-top text-bg-dark"
  tabindex="-1"
  id="tableOfContentsCanvas"
  aria-labelledby="tableOfContentsCanvasLabel"
  style="height: 75vh;"
>
  <div class="offcanvas-header justify-content-between align-items-center">
    <h5 class="offcanvas-title" id="tableOfContentsCanvasLabel">
      Table of Contents
    </h5>
    <button
      type="button"
      class="btn-close btn-close-white"
      data-bs-dismiss="offcanvas"
      aria-label="Close"
    ></button>
  </div>

  <div class="offcanvas-body bg-dark text-white">
    <div class="articleInfo articleInfoBtnInCanvas">
      <button
              // class="btn-back"
              aria-label="Back to articles"
              onclick="history.back()"
            >
               <i class="material-icons">keyboard_backspace</i> <i>Back </i>
            </button>
      <button
  type="button"
  data-bs-toggle="offcanvas"
  data-bs-target="#magInfoCanvas"
  aria-controls="magInfoCanvas"
  aria-label="Magazine Info"
>
  <i>Article Details</i> <i class="material-icons">arrow_forward</i>
</button>
 
    </div>
    <% if (mag.hasToc && tocs.length > 0) { 
      tocs.sort((a, b) => {
  const aPage = parseInt((a.pages || '').split(',')[0]) || 0;
  const bPage = parseInt((b.pages || '').split(',')[0]) || 0;
  return aPage - bPage;
});

      %>
      <div class="mag-contents">
        <% if (mag.links && mag.links.length > 0) { %>
  <span>Interview Links</span>
  <ul class="list-unstyled mt-2 d-flex flex-row">
    <% mag.links.forEach((rawLink) => { 
      const parts = rawLink.split('--');
      const site = parts[0].trim();
      const url = parts[1]?.trim();

      // Basic safety check
      if (!url) return;

      let color = 'secondary';
      let icon = 'bi-link-45deg';
      let label = site.charAt(0).toUpperCase() + site.slice(1); 

      switch (site.toLowerCase()) {
        case 'youtube':
          color = 'danger';
          icon = 'bi-youtube';
          break;
        case 'spotify':
          color = 'success';
          icon = 'bi-spotify';
          break;
        case 'vimeo':
          color = 'info';
          icon = 'bi-play-btn';
          break;
        case 'apple':
        case 'apple podcasts':
          color = 'dark';
          icon = 'bi-apple';
          break;
        case 'soundcloud':
          color = 'warning';
          icon = 'bi-soundwave'; // Bootstrap doesn't have this; customize if needed
          break;
        case 'instagram':
          color = 'danger';
          icon = 'bi-instagram';
          break;
        case 'facebook':
          color = 'primary';
          icon = 'bi-facebook';
          break;
        case 'twitter':
        case 'x':
          color = 'dark';
          icon = 'bi-twitter-x';
          break;
        case 'linkedin':
          color = 'primary';
          icon = 'bi-linkedin';
          break;
        case 'tiktok':
          color = 'dark';
          icon = 'bi-tiktok'; // Not available in Bootstrap Icons — fallback to globe
          break;
        default:
          color = 'secondary';
          icon = 'bi-globe';
      }
    %>
      <li class="m-1">
        <a href="<%= url %>" target="_blank" class="btn btn-sm btn-<%= color %>">
          <i class="bi <%= icon %>"></i> <%= label %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>No links available.</p>
<% } %>

        <small>Click to go to the story:</small>
        <div class="book-toc">
        <% tocs.forEach((toc, index) => { %>
          <div class="toc-entry">
            <div class="toc-title">
              <%= toc.title %>
              <% if (toc.subTitle) { %>
                <br> <small class="toc-subtitle"> - <%= toc.subTitle %></small>
              <% } %>
            </div>
            <div class="toc-leader"></div>
            <div class="toc-page">
              <% const tocsList = toc.pages.split(',')
                if (tocsList.length > 1) {
                  tocsList.forEach((tocPage, index) => { %>
                    <span <%= index === 0 ? `class=tocNumber` : '' %>><%= tocPage %>, </span>

                  <% })
                } else { %>
                  <span class="tocNumber"><%= toc.pages %></span>
                <% }
              %>
              
            </div>
          </div>
        <% }); %>
      </div>
      </div>
    <% } else { %>
      <p>No Table of Contents available.</p>
    <% } %>
  </div>
</div>

      </section>

      

      

      

      <section class="bottom">
        <div class="controls-bottom">

            <button
              type="button"
              id="switchViewBtn"
              // class="thumbNailsBtn"
              // data-bs-toggle="offcanvas"
              // data-bs-target="#thumbnailsCanvas"
              // aria-controls="thumbnailsCanvas"
              aria-label="Single Page View"
            >
              <i class="material-icons">article</i>
            </button>

            <button
              type="button"
              class="showTocsBtn showTocsBtnMobile"
              data-bs-toggle="offcanvas"
              data-bs-target="#tableOfContentsCanvas"
              aria-controls="tableOfContentsCanvas"
              aria-label="Table of Contents"
              data-has-tocs="<%= mag.hasToc %>"
            >
              <i class="material-icons">toc</i>
            </button>

          <button class="btn-skip-backward" aria-label="Skip Page Backward">
            <i class="material-icons">skip_previous</i>
          </button>

          <button class="btn-prev-page" aria-label="Previous Page">
            <i class="material-icons">navigate_before</i>
          </button>

          <div class="page-counts">
            <h4>
              <span id="current-page">0</span> /
              <span id="total-pages">0</span> 
            </h4>
          </div>

          <button class="btn-next-page" aria-label="Next Page">
            <i class="material-icons">navigate_next</i>
          </button>

          <button class="btn-skip-forward" aria-label="Skip Page Forward">
            <i class="material-icons">skip_next</i>
          </button>

          <% if (mag.links && mag.links.length > 0) { 
            let foundYoutube = false;
            for (let i = 0; i < mag.links.length; i++) {
              const link = mag.links[i];
              const parts = link.split('--');
              const site = parts[0].trim();
              const url = parts[1]?.trim();

              if (site.toLowerCase() === 'youtube') {
                const color = 'danger';
                const icon = 'bi-youtube';
                const label = site.charAt(0).toUpperCase() + site.slice(1);
                foundYoutube = true;
          %>
                <a href="<%= url %>" target="_blank" class="m-1 me-3 btn btn-sm btn-<%= color %> yt-btn">
                  <i class="bi <%= icon %>"></i> <%= label %>
                </a>
          <%    
                break; // exit after first YouTube link
              }
            }
          } %>

        </div>
      </section>
    </div>
    <% } %>

    <!-- Bootstrap -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>

    <script src="view/public/assets/scripts/article.js"></script>
    <script src="view/public/assets/scripts/script.js"></script>
    <script src="view/public/assets/scripts/page-flip.browser.js"></script>
    <script src="view/public/assets/scripts/share.js"></script>
    // <script src="view/public/assets/scripts/tracker.js"></script>
  </body>
</html>
