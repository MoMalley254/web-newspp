<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content="Business Unusual Magazine" />
      <meta 
        property="og:description" 
        content="BUSINESS UNUSUAL MAGAZINE
          Aims to provide high-quality, accurate,
          and timely business content that
          empowers entrepreneurs, investors,
          and policymakers with the knowledge
          to make informed decisions, fostering
          innovation, economic growth, and sustainable development in Kenya
          and beyond." 
      />
      <meta property="og:url" content="<%= fullUrl %>" />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Business Unusual Magazine" />
    <!-- Google Material Icons -->
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <!-- Bootstrap -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/front/tag/public/assets/styles/styles.css" />
    <title>Business Unusual</title>
  </head>
  <body>
    <section class="top">
      <div class="titles front">
        <!-- <h1>E-Newspp</h1> -->
        <h1 id="magazineTitle">
          <%= typeof tag !== 'undefined' && tag.name ? tag.name : "Business Unusual" %>
        </h1>
      </div>
    </section>

    <div class="content-body no-content">
      <section id="articlesSection" class="content">
        <% if (typeof mags !== 'undefined' && mags.length > 0) { %>
          <p class="foundItems">
            Showing <span id="foundItems"><%= mags.length %></span> articles
          </p>

          <div id="article-thumbnails" class="front">
            <% mags.forEach((mag) => { 
              const imageUrl = `/front${mag.coverImage.replace(/\\/g, '/').replace(/\/+/g, '/')}`;
            %>
              <div
                data-identifier="<%= mag.id %>"
                class="article-thumbnail"
                style="
                  background-image: radial-gradient(circle at bottom left, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.3) 40%, transparent 80%), url('<%= imageUrl %>');
                  background-size: cover;
                  background-position: center;
                  color: #f2eaeaff;
                "
              >
                <span><%= mag.title %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="center container mt-3" style="margin-top: 25vh;">
            <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
              <div>
                <strong>Error:</strong> <br />
                <%= error %>
              </div>
              <br />
              <div>
                <button class="btn btn-outline-success btn-sm me-2" onclick="location.reload()">Reload</button>
                <button class="btn btn-outline-danger btn-sm" onclick="history.back()">Go Back</button>
              </div>
            </div>
          </div>
        <% } %>

        <div class="copy">
          <p>
            Ela Creatives <br />
            &copy; <span id="copy"></span>
          </p>
        </div>
      </section>

      <section class="bottom"></section>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="/front/tag/public/assets/scripts/group.js"></script>
  </body>
</html>
