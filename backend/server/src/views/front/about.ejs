<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content="Business Matters Magazine" />
    <meta
      property="og:description"
      content="BUSINESS MATTERS MAGAZINE
          Aims to provide high-quality, accurate,
          and timely business content that
          empowers entrepreneurs, investors,
          and policymakers with the knowledge
          to make informed decisions, fostering
          innovation, economic growth, and sustainable development in Kenya
          and beyond."
    />
    <meta property="og:url" content="<%= fullUrl %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Business Matters Magazine" />

    <meta name="twitter:title" content="Business Matters Magazine" />
    <meta
      name="twitter:description"
      content="BUSINESS MATTERS MAGAZINE
          Aims to provide high-quality, accurate,
          and timely business content that
          empowers entrepreneurs, investors,
          and policymakers with the knowledge
          to make informed decisions, fostering
          innovation, economic growth, and sustainable development in Kenya
          and beyond."
    />
    <meta name="twitter:url" content="<%= fullUrl %>" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />

    <!-- Google Material Icons -->
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <!-- Bootstrap -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="public/assets/styles/styles.css" />
    <title>Business Matters</title>
    <style>
      #frontContent {
        overflow: hidden;
      }
      .title {
        margin-top: 10vh;
      }

      .lead {
        width: 60vw;
        margin: 5vh 20vw;
        overflow: hidden;
      }

      .contacts-sect {
        overflow: hidden;
        margin-top: 10vh;
        margin-bottom: 10vh;
      }

      @media (max-width: 768px) {
        #frontContent {
          overflow-y: scroll;
          height: 90vh;
        }
        .title {
          margin-top: 5vh;
        }

        .lead {
          width: 90vw;
          margin: 3vh 5vw;
          font-size: 18px;
          overflow: hidden;
        }

        .contacts-sect {
          overflow: hidden;
          margin-top: 5vh;
          margin-bottom: 10vh;
        }
      }

      @media (min-width: 760px) and (max-width: 1024px) {
        #frontContent {
          overflow-y: hidden;
        }
        .contacts-sect {
          overflow: hidden;
          margin-top: 2vh;
          margin-bottom: 10vh;
        }
      }
    </style>
  </head>

  <body>
    <section id="frontContent" class="text-center">
      <div>
        <h2 class="title">About Business Matters</h2>
        <p class="lead">
          Business Matters is a leading digital magazine dedicated to providing
          actionable insights, in-depth features, and expert opinions to
          business owners, entrepreneurs, and industry leaders. Our mission is
          to inform, inspire, and equip our readers with the knowledge they need
          to thrive in today’s fast-paced business environment.
        </p>

        <div class="row justify-content-center">
          <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title">Our Mission</h5>
                <p class="card-text text-dark">
                  To empower business professionals with the latest trends,
                  expert strategies, and real-world case studies that help them
                  grow and innovate in their respective industries.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
              <div class="card-body">
                <h5 class="card-title">Our Vision</h5>
                <p class="card-text text-dark">
                  To be the go-to magazine for business leaders seeking
                  valuable, relevant, and insightful content that propels their
                  success and keeps them ahead of the competition.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="contacts-sect">
          <h4>Contact Us</h4>
          <p class="mb-2">Have questions or feedback? Get in touch!</p>
          <p class="fw-bold">
            Email:
            <a href="mailto:info@businessmatters.co.ke"
              >info@businessmatters.co.ke</a
            >
          </p>
          <div class="social-icons mt-3">
            <a
              href="https://facebook.com/businessmatters"
              target="_blank"
              class="me-3 text-primary fs-4"
              ><i class="fab fa-facebook"></i
            ></a>
            <a
              href="https://twitter.com/businessmatters"
              target="_blank"
              class="me-3 text-info fs-4"
              ><i class="fab fa-twitter"></i
            ></a>
            <a
              href="https://linkedin.com/company/businessmatters"
              target="_blank"
              class="me-3 text-primary fs-4"
              ><i class="fab fa-linkedin"></i
            ></a>
            <a
              href="https://instagram.com/businessmatters"
              target="_blank"
              class="text-danger fs-4"
              ><i class="fab fa-instagram"></i
            ></a>
          </div>
        </div>
      </div>
    </section>

    <a href="/front" class="home-btn">
      <span class="material-icons me-3">keyboard_backspace</span
      ><span>Home</span>
    </a>
    <!-- Bootstrap JS, Popper, and jQuery (optional) -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
  </body>
</html>
