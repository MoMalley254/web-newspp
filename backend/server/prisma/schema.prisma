
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id String @id @default(uuid())
  email String @unique
  name String 
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  magazines Magazine[]
}

model Tag {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())

  magazines Magazine[] @relation("MagazineTags")
}

model Magazine {
  id String @id @default(uuid())
  title String 
  issueNumber Int 
  publishDate DateTime @default(now())
  description String?
  publisher String?
  htmlPath String 
  coverImage String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags        Tag[]      @relation("MagazineTags")

  admin Admin @relation(fields: [adminId], references: [id])
  adminId String

  credits Json?
}

model MagzineReadingSession {
  id String @id @default(uuid())

  // Device/session metadata
  fingerprint  String
  location     String?   // optional, from IP geolocation
  deviceType   String    // e.g. "desktop", "mobile", etc.
  language     String    // e.g. "en-US"

  // Magazine context
  magazineId   String    // required, refers to specific magazine

  // Reading behavior
  startedAt    DateTime
  endedAt      DateTime?
  completed    Boolean   @default(false) // did they reach the last page?

  // Per-page data
  pages        Json      // e.g. [{ "pageNumber": 1, "timeSpent": 12 }, ...]

  //Make querying these easier
  @@index([fingerprint])
  @@index([magazineId])
}

